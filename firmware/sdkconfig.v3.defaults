# ESP32-P4 v3.x with the existing 32MB board layout and unchanged UI timing.
# CONFIG_ESP32P4_SELECTS_REV_LESS_V3 is not set
CONFIG_ESP32P4_REV_MIN_300=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_400=y

# Keep LPRAM out of the general heap: AEC3 128-bit copies cannot use it.
# CONFIG_ESP_SYSTEM_ALLOW_RTC_FAST_MEM_AS_HEAP is not set
